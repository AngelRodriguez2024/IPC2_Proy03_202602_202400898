@page
@model ConsultasModel
@{
    ViewData["Title"] = "Consultas y Reportes";
}

<div class="container mt-4">
    <h2>Apartado de Peticiones y Reportes</h2>
    <hr />

    <!-- 1. Consultar Contribuyente -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">1. Consultar Contribuyente</div>
        <div class="card-body">
            <form method="get" asp-page-handler="ConsultarContribuyente" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">NIT:</label>
                    <input type="text" name="nit" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fecha Inicio:</label>
                    <input type="text" name="fechaInicio" class="form-control" placeholder="dd/mm/yyyy" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fecha Fin:</label>
                    <input type="text" name="fechaFin" class="form-control" placeholder="dd/mm/yyyy" required />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-success w-100">Consultar</button>
                </div>
            </form>

            @if (Model.ResultadoConsulta != null)
            {
                <div class="mt-3">
                    <p><strong>Total Facturas:</strong> @Model.ResultadoConsulta.totalFacturasAutorizadas</p>
                    <p><strong>Monto Total:</strong> Q @Model.ResultadoConsulta.montoTotalFacturado</p>
                </div>
            }
        </div>
    </div>

    <!-- 2. Resumen de IVA por Fecha -->
    <div class="card mb-4">
        <div class="card-header bg-secondary text-white">2. Resumen de IVA por Fecha y NIT</div>
        <div class="card-body">
            <form method="get" asp-page-handler="ResumenIva" class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Fecha a filtrar:</label>
                    <input type="text" name="fecha" class="form-control" placeholder="dd/mm/yyyy" required />
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <button type="submit" class="btn btn-secondary w-100">Obtener Resumen IVA</button>
                </div>
            </form>

            @if (!string.IsNullOrEmpty(Model.JsonResumenIva))
            {
                <pre class="bg-light p-3 border mt-3">@Model.JsonResumenIva</pre>
            }
        </div>
    </div>

    <!-- 3. Resumen por Rango de Fechas -->
    <div class="card mb-4">
        <div class="card-header bg-dark text-white">3. Resumen por Rango de Fechas</div>
        <div class="card-body">
            <form method="get" asp-page-handler="ResumenRango" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Fecha Inicio:</label>
                    <input type="text" name="fechaInicio" class="form-control" placeholder="dd/mm/yyyy" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Fecha Fin:</label>
                    <input type="text" name="fechaFin" class="form-control" placeholder="dd/mm/yyyy" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Montos:</label>
                    <select name="conIva" class="form-select">
                        <option value="true">Con IVA</option>
                        <option value="false">Sin IVA</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-dark w-100">Filtrar</button>
                </div>
            </form>

            @if (!string.IsNullOrEmpty(Model.JsonResumenRango))
            {
                <pre class="bg-light p-3 border mt-3">@Model.JsonResumenRango</pre>
            }
        </div>
    </div>
</div>  